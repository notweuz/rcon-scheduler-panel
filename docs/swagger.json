    "definitions": {
        "request.AuthCredentials": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 40,
                    "minLength": 8
                },
                "username": {
                    "type": "string",
                    "maxLength": 20,
                    "minLength": 3
                }
            }
        },
        "request.CreateJob": {
            "type": "object",
            "required": [
                "cron",
                "name",
                "steps"
            ],
            "properties": {
                "cron": {
                    "type": "string",
                    "maxLength": 75
                },
                "log_results": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                },
                "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/request.Step"
                    }
                }
            }
        },
        "request.CreateServer": {
            "type": "object",
            "required": [
                "address",
                "name",
                "password",
                "port",
                "protocol_id"
            ],
            "properties": {
                "address": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                },
                "password": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 8
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                },
                "protocol_id": {
                    "type": "integer"
                }
            }
        },
        "request.ExecuteCommand": {
            "type": "object",
            "required": [
                "command"
            ],
            "properties": {
                "command": {
                    "type": "string",
                    "maxLength": 1000
                }
            }
        },
        "request.Step": {
            "type": "object",
            "properties": {
                "command": {
                    "type": "string"
                },
                "wait": {
                    "type": "string"
                }
            }
        },
        "request.UpdateServer": {
            "type": "object",
            "required": [
                "address",
                "name",
                "port",
                "protocol_id"
            ],
            "properties": {
                "address": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "name": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                },
                "password": {
                    "type": "string",
                    "maxLength": 24,
                    "minLength": 8
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                },
                "protocol_id": {
                    "type": "integer"
                }
            }
        },
        "response.ExecuteResult": {
            "type": "object",
            "properties": {
                "output": {
                    "type": "string"
                }
            }
        },
        "response.InvalidParam": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "min"
                },
                "field": {
                    "type": "string",
                    "example": "name"
                },
                "param": {
                    "type": "string",
                    "example": "3"
                }
            }
        },
        "response.Job": {
            "type": "object",
            "properties": {
                "cron": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "log_results": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "server_id": {
                    "type": "integer"
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/response.Step"
                    }
                }
            }
        },
        "response.JobList": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/response.Job"
                    }
                }
            }
        },
        "response.Problem": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "SERVER_NOT_FOUND"
                },
                "detail": {
                    "type": "string",
                    "example": "server not found"
                },
                "errors": {
